# Copy to .env (gitignored) and fill in. See docs/ARCHITEKTUR.md section 12.

# Required: bearer token the API expects in `Authorization: Bearer <token>`.
# Generate one, do not keep the placeholder: `openssl rand -hex 32`.
# Must be at least 16 characters and not the literal "change-me"; the
# server refuses to start otherwise.
FADEN_TOKEN=change-me

# Root folder mounted read-only inside the container. Can be broader than
# the actual audiobook folder (e.g. a whole NAS share); pick the real
# subfolder via the setup page at /setup, or by setting settings.library_path
# directly in the database. See docs/ARCHITEKTUR.md sections 10, 12 (E12).
FADEN_LIBRARY=/library

# SQLite database and caches.
FADEN_DATA=/data

# Port the server listens on.
FADEN_PORT=8787

# Background rescan interval, in minutes.
FADEN_RESCAN_MIN=10

# silencedetect threshold (dB) and minimum silence duration (s) for the pause index.
FADEN_SILENCE_DB=-35
FADEN_SILENCE_S=0.35

# Host-side path to the audiobook folder, used by docker-compose.yml at the repo root.
FADEN_LIBRARY_HOST=./library

# User/group the container runs as (docker-compose.yml `user:`). Must be able to
# read the audiobook share. On the NAS: `id <nas-user>` shows uid and gid.
FADEN_UID=10001
FADEN_GID=10001

# Look up missing book genres in public catalogs (Deutsche Nationalbibliothek,
# then Google Books, then Open Library) in the background after each scan.
# Only title and author are sent. 0 disables it; manual genres work either way.
FADEN_GENRE_LOOKUP=1
