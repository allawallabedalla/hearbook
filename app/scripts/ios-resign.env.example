# Nach ios-resign.env kopieren (gitignored) und ausfüllen.
# Siehe README, Abschnitt "iOS ohne Bezahl-Account".

# iPhone-Kennung aus `xcrun devicectl list devices` (Spalte "Identifier").
FADEN_DEVICE=

# Muss zur Bundle-ID des Targets "Runner" in Xcode passen.
BUNDLE_ID=de.faden.faden

# Nur erneuern, wenn die letzte erfolgreiche Erneuerung mindestens so viele Tage her ist.
MIN_DAYS=3

# Zusätzliche PATH-Einträge (durch : getrennt), falls flutter oder pod nicht unter
# /opt/homebrew/bin oder /usr/local/bin liegen, z. B. $HOME/development/flutter/bin
EXTRA_PATH=
